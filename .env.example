# Optional: set a stable Fernet key for the local vault.
# Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If omitted, the app creates instance/master.key on first run.
APP_MASTER_KEY=
FLASK_SECRET_KEY=replace-this-for-any-non-local-deployment
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
